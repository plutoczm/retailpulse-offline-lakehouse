RETAILPULSE_APP_NAME=RetailPulse AI Analyst
RETAILPULSE_ENV=development
RETAILPULSE_METRICS_PATH=dashboard/data/dashboard.json
RETAILPULSE_FALLBACK_METRICS_PATH=dashboard/data/demo.json
RETAILPULSE_ALLOW_DEMO_FALLBACK=true
RETAILPULSE_METRICS_MAX_AGE_SECONDS=0

# Optional API protection and runtime controls.
RETAILPULSE_API_KEY=
RETAILPULSE_RATE_LIMIT_PER_MINUTE=30
RETAILPULSE_RESPONSE_CACHE_TTL_SECONDS=60
RETAILPULSE_RESPONSE_CACHE_MAX_ENTRIES=256

# Optional: when empty, the app runs in deterministic offline mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_TIMEOUT_SECONDS=20

# Offline lakehouse defaults.
RETAILPULSE_DATA_ROOT=data
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_SQL_SHUFFLE_PARTITIONS=8
HADOOP_HOME=.runtime/hadoop
